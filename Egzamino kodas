print('\nSLENKSČIO ANALIZĖ (10*FN + 1*FP KAINA)')
print(threshold_df.to_string(index=False))
print(f"Geriausias slenkstis pagal pavyzdinę klaidos kainą: {best_threshold['threshold']}")
print('\nVYKDYMO LAIKAI (sekundėmis)')
print(base[['model','seconds']].to_string(index=False))
print(f"Pagrindinių modelių mokymo ir vertinimo laiko suma: {base['seconds'].sum():.4f} s")
print(f"Daugiaklasio Random Forest laikas: {type_seconds:.4f} s")
print(f"Bendras užregistruotas skaičiavimo laikas: {base['seconds'].sum()+type_seconds:.4f} s")
print('\nSKAIČIAVIMO BIUDŽETO INTERPRETACIJA')
print('Baseline ir logistinė regresija yra greičiausi atskaitos metodai.')
