print('Random Forest laikas didesnis, nes mokoma 300 sprendimų medžių.')
print('Laikai priklauso nuo naudojamo kompiuterio ir nėra universalus aparatinės įrangos etalonas.')
print('\nPAGRINDINIAI IŠSAUGOTI REZULTATŲ FAILAI')
for result_file in ['main_results.csv','ablation_results.csv','robustness_results.csv','hypothesis_result.json','failure_type_results.json','failure_type_confusion_matrix.csv','threshold_analysis.csv','threshold_result.json','01_modeliu_pr_auc.png','02_precision_recall_kreives.png','03_random_forest_klaidu_matrica.png','04_abliacija_tool_wear.png','05_atsparumo_grafikas.png','06_slenkscio_analize.png']:
