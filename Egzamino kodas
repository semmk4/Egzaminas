# 10. HIPOTEZĖS PATIKRINIMAS
# Plane iškelta hipotezė: MLP PR-AUC turi būti bent 15 % didesnis
# už logistinės regresijos PR-AUC. Skaičiuojamas santykinis skirtumas.
log_pr=float(base.loc[base['model']=='Logistic regression','pr_auc'].iloc[0]); mlp_pr=float(base.loc[base['model']=='MLP','pr_auc'].iloc[0]); relative_gain=(mlp_pr-log_pr)/log_pr if log_pr else float('inf'); hypothesis_pass=relative_gain>=0.15
print(f"\nHIPOTEZĖ: MLP PR-AUC turi būti bent 15 % didesnis už logistinės regresijos PR-AUC")
print(f"Logistinė regresija: {log_pr:.4f}; MLP: {mlp_pr:.4f}; santykinis skirtumas: {relative_gain*100:.2f} %")
print('Hipotezė PATVIRTINTA.' if hypothesis_pass else 'Hipotezė NEPATVIRTINTA.')
(OUT/'hypothesis_result.json').write_text(json.dumps({'logistic_pr_auc':log_pr,'mlp_pr_auc':mlp_pr,'relative_gain':relative_gain,'threshold':0.15,'supported':hypothesis_pass},indent=2),encoding='utf-8')
print('\nABLIACIJA – PAŠALINTAS TOOL WEAR')
print(pd.DataFrame(ab)[['model','pr_auc','precision','recall']].to_string(index=False))
print('\nATSPARUMAS')
